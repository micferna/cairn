<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde cloud et transfert d'appareil à appareil : TOUT est exclu.
  Les données de Cairn ne partent pas chez Google Drive, ni sur un nouveau
  téléphone via le transfert automatique. Le seul moyen de les déplacer est
  l'export manuel et explicite depuis l'écran Confidentialité.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
