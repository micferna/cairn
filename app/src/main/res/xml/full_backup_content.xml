<?xml version="1.0" encoding="utf-8"?>
<!--
  Équivalent de data_extraction_rules.xml pour Android 11 et antérieur.
  allowBackup="false" suffit déjà à bloquer la sauvegarde, mais on double la
  garantie : si une version future réactivait la sauvegarde par inadvertance,
  ces exclusions resteraient en place.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
